				</collision>
			</xacro:if>


		</link>

		<joint name="${prefix}joint5" type="revolute">
			<origin xyz="0.0 ${-direction * 0.43071} 4.6056e-05"
			        rpy="-1.5707999999999998 0.0 ${(direction + 1.0) * PI / 2.0}"/>
			<parent link="${prefix}link4"/>
			<child link="${prefix}link5"/>
			<axis xyz="0.0 0.0 ${direction}"/>
			<limit lower="-2.9496" upper="2.9496" effort="1000.0" velocity="1.5"/>
		</joint>

		<link name="${prefix}link6">
			<visual>
				<geometry>
					<mesh filename="file://$(find galbot_s1_description)/meshes/visual/arm/link6.glb" scale="1 ${direction} 1"/>
				</geometry>
			</visual>


			<inertial>
				<origin xyz="0.00014000000000000001 -0.00592 2e-05"/>
				<mass value="1.38"/>
				<inertia ixx="0.00150343" ixy="2.31e-06" ixz="7.5e-06"
				         iyy="0.0014874200000000001" iyz="7.7e-06" izz="0.00142655"/>
			</inertial>
			<xacro:if value="${collision_type == 'simple'}">
				<collision name="S1_${name}_arm_link_6_collision01_cyl">
					<origin xyz="9.386567398905754e-07 ${direction * 0.0012309737503528595} -6.677606143057346e-05"
					        rpy="1.5536174764470232 0.01919750594195202 0.01887053470044997"/>
					<geometry>
						<cylinder length="0.09136159718036652" radius="0.046068303287029266"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_6_collision02_cyl">
					<origin xyz="-4.431468525467608e-08 ${direction * -1.5574856959688077e-08} 0.004999995231628418"
					        rpy="5.0726812972357025e-08 -6.672987473699266e-08 -1.7867101231145398e-22"/>
					<geometry>
						<cylinder length="0.10000000149011612" radius="0.033000003546476364"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collision_type == 'convex_decomposition'}">
				<collision>
					<geometry>
						<mesh
								filename="file://$(find galbot_s1_description)/meshes/collision/convex_decomposition/arm/link6_0.stl"
								scale="1 ${direction} 1"/>
					</geometry>
				</collision>
				<collision>
					<geometry>
						<mesh
								filename="file://$(find galbot_s1_description)/meshes/collision/convex_decomposition/arm/link6_1.stl"
								scale="1 ${direction} 1"/>
					</geometry>
				</collision>
				<collision>
					<geometry>
						<mesh
								filename="file://$(find galbot_s1_description)/meshes/collision/convex_decomposition/arm/link6_2.stl"
								scale="1 ${direction} 1"/>
					</geometry>
				</collision>
			</xacro:if>


		</link>

		<joint name="${prefix}joint6" type="revolute">
			<origin rpy="1.5707926535906556 -1.5707926535897931 3.1415926535889307"/>
			<parent link="${prefix}link5"/>
			<child link="${prefix}link6"/>
			<axis xyz="0.0 0.0 ${direction}"/>
			<limit lower="-0.7854" upper="0.7854" effort="1000.0" velocity="1.5"/>
		</joint>

		<link name="${prefix}link7">
			<visual>
				<geometry>
					<mesh filename="file://$(find galbot_s1_description)/meshes/visual/arm/link7.glb"/>
				</geometry>
			</visual>


			<inertial>
				<origin xyz="-0.09705 0.00667 0.01357"/>
				<mass value="1.31"/>
				<inertia ixx="0.00224557" ixy="0.0010953699999999998" ixz="0.00101009"
				         iyy="0.01539758" iyz="0.00025852" izz="0.01517141"/>
			</inertial>
			<xacro:if value="${collision_type == 'simple'}">
				<collision name="S1_${name}_arm_link_7_collision01_box">
					<origin xyz="-0.13842377066612244 ${direction * 0.0656345933675766} 0.025309942662715912"/>
					<geometry>
						<box size="0.1309584081172943 0.029024913907051086 0.04264015704393387"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_7_collision02_cyl">
					<origin xyz="-0.1062505766749382 ${direction * 0.00019049629918299615} -5.03755290992558e-05"
					        rpy="2.296369301482078e-05 -1.5707714557646106 -9.541384706046705e-12"/>
					<geometry>
						<cylinder length="0.06749957799911499" radius="0.039692968130111694"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_7_collision03_box">
					<origin xyz="-0.03664719685912132 0.0 0.04845893383026123"/>
					<geometry>
						<box size="0.14330530166625977 0.07001465559005737 0.04002520442008972"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collision_type == 'convex_decomposition'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find galbot_s1_description)/meshes/collision/convex_decomposition/arm/link7_0.stl"

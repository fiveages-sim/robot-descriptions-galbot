		<joint name="${prefix}joint7" type="revolute">
			<origin rpy="${-direction * 1.5707999999999998} 0.0 ${direction * 3.1415853071795863}"/>
			<parent link="${prefix}link6"/>
			<child link="${prefix}link7"/>
			<axis xyz="0.0 0.0 ${direction}"/>
			<limit lower="-1.5882" upper="1.5882" effort="1000.0" velocity="1.5"/>
		</joint>

		<link name="${prefix}end_effector_mount_link"/>

		<joint name="${prefix}end_effector_mount_joint" type="fixed">
			<origin xyz="-0.135 0.0 0.0" rpy="3.1415853071795867 0.0 -3.1415853071795867"/>
			<parent link="${prefix}link7"/>
			<child link="${prefix}end_effector_mount_link"/>
		</joint>

		<link name="${prefix}camera_stand">
			<visual>
				<geometry>
					<mesh filename="file://$(find galbot_s1_description)/meshes/visual/arm/camera_stand_right.glb"
					      scale="1 ${-direction} 1"/>
				</geometry>
			</visual>
		</link>

		<joint name="${prefix}camera_stand_joint" type="fixed">
			<parent link="${prefix}link7"/>
			<child link="${prefix}camera_stand"/>
		</joint>

		<link name="${prefix}camera">
			<visual>
				<geometry>
					<mesh filename="file://$(find sensor_models)/meshes/realsense/d435.glb"/>
				</geometry>
			</visual>
		</link>

		<joint name="${prefix}camera_joint" type="fixed">
			<origin xyz="-0.119876 ${direction * 0.062796} 0.039445" rpy="${-direction * PI * 15 / 180} ${PI*8/180} ${PI}"/>
			<parent link="${prefix}camera_stand"/>
			<child link="${prefix}camera"/>
		</joint>
	</xacro:macro>

</robot>

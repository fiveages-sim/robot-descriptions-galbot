<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="arm">

	<!--
		Unified arm entry macro for S1.
		direction:=1  -> left arm
		direction:=-1 -> right arm
	-->
	<xacro:macro name="Arm" params="name:='' direction:=1 parent collision_type">
		<xacro:property name="prefix" value="${name + '_' if name else ''}"/>

		<joint name="${prefix}base_joint" type="fixed">
			<parent link="${parent}"/>
			<child link="${prefix}base_link"/>
		</joint>

		<link name="${prefix}base_link">
			<visual>
				<origin rpy="0 0 ${(1.0 - direction) * PI / 2.0}"/>
				<geometry>
					<mesh filename="file://$(find galbot_s1_description)/meshes/visual/arm/arm_base_link.glb"/>
				</geometry>
			</visual>
		</link>

		<link name="${prefix}link1">
			<visual>
				<origin rpy="0 0 ${(1.0 - direction) * PI / 2.0}"/>
				<geometry>
					<mesh filename="file://$(find galbot_s1_description)/meshes/visual/arm/link1.glb"/>
				</geometry>
			</visual>
			<inertial>
				<origin xyz="-4e-05 0.011630000000000001 -0.025160000000000002"/>
				<mass value="5.53"/>
				<inertia ixx="0.02654522" ixy="3.3310000000000005e-05" ixz="5.019999999999999e-06"
				         iyy="0.02641597" iyz="2.2899999999999998e-05" izz="0.01622133"/>
			</inertial>
			<xacro:if value="${collision_type == 'simple'}">
				<collision name="S1_${name}_arm_link_1_collision01_cyl">
					<origin xyz="2.3283064365386963e-09 ${direction * -0.0005000084638595581} -7.450580596923828e-09"
					        rpy="-1.5707962512969962 -8.742278256868019e-08 8.742277624040895e-08"/>
					<geometry>
						<cylinder length="0.12199998646974564" radius="0.07349997758865356"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_1_collision02_cyl">
					<origin xyz="0.0 ${direction * -4.6566128730773926e-09} -0.06851434707641602"/>
					<geometry>
						<cylinder length="0.10504480451345444" radius="0.07099999487400055"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collision_type == 'convex_decomposition'}">
				<collision>
					<geometry>
						<mesh
								filename="file://$(find galbot_s1_description)/meshes/collision/convex_decomposition/arm/link1_0.stl"
								scale="1 ${direction} 1"/>
					</geometry>
				</collision>
				<collision>
					<geometry>
						<mesh
								filename="file://$(find galbot_s1_description)/meshes/collision/convex_decomposition/arm/link1_1.stl"
								scale="1 ${direction} 1"/>
					</geometry>
				</collision>
				<collision>
					<geometry>
						<mesh
								filename="file://$(find galbot_s1_description)/meshes/collision/convex_decomposition/arm/link1_2.stl"
								scale="1 ${direction} 1"/>
					</geometry>
				</collision>
				<collision>
					<geometry>
						<mesh
								filename="file://$(find galbot_s1_description)/meshes/collision/convex_decomposition/arm/link1_3.stl"
								scale="1 ${direction} 1"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<joint name="${prefix}joint1" type="revolute">
			<origin rpy="0.0 0.0 ${direction * 0.5236}"/>
			<parent link="${prefix}base_link"/>
			<child link="${prefix}link1"/>
			<axis xyz="0.0 0.0 ${direction}"/>
			<limit lower="-2.9671" upper="2.9671" effort="1000.0" velocity="1.5"/>
		</joint>


		<link name="${prefix}link2">
			<visual>
				<geometry>
					<mesh filename="file://$(find galbot_s1_description)/meshes/visual/arm/link2.glb" scale="1 ${direction} 1"/>
				</geometry>
			</visual>


			<inertial>
				<origin xyz="7.000000000000001e-05 0.14678 0.00057"/>
				<mass value="5.23"/>
				<inertia ixx="0.15467273" ixy="0.00102313" ixz="0.00015052000000000002"
				         iyy="0.019662" iyz="0.00070935" izz="0.14633601000000002"/>
			</inertial>
			<xacro:if value="${collision_type == 'simple'}">
				<collision name="S1_${name}_arm_link_2_collision01_cyl">
					<origin xyz="-1.1487907613627613e-05 ${direction * 0.17920906841754913} -1.75914065039251e-05"
					        rpy="1.5707975625983903 -5.234979381096849e-07 -5.234986986124568e-07"/>
					<geometry>
						<cylinder length="0.11758198589086533" radius="0.061299942433834076"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_2_collision02_box">
					<origin xyz="2.1383166313171387e-06 ${direction * 0.13731816411018372} 0.0005058906972408295"/>
					<geometry>
						<box size="0.12799572944641113 0.054379209876060486 0.17659130692481995"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_2_collision03_box">
					<origin xyz="7.450580596923828e-09 ${direction * 0.009496860206127167} 0.08199715614318848"/>
					<geometry>
						<box size="0.14701241254806519 0.16600626707077026 0.032816313207149506"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_2_collision04_box">
					<origin xyz="-2.43261456489563e-06 ${direction * 0.010303709656000137} -0.07619750499725342"/>
					<geometry>
						<box size="0.147007554769516 0.1676199734210968 0.04481569305062294"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collision_type == 'convex_decomposition'}">
				<collision>
					<geometry>
						<mesh
								filename="file://$(find galbot_s1_description)/meshes/collision/convex_decomposition/arm/link2_0.stl"
								scale="1 ${direction} 1"/>
					</geometry>
				</collision>
				<collision>
					<geometry>
						<mesh
								filename="file://$(find galbot_s1_description)/meshes/collision/convex_decomposition/arm/link2_1.stl"
								scale="1 ${direction} 1"/>
					</geometry>
				</collision>
				<collision>
					<geometry>
						<mesh
								filename="file://$(find galbot_s1_description)/meshes/collision/convex_decomposition/arm/link2_2.stl"
								scale="1 ${direction} 1"/>
					</geometry>
				</collision>
			</xacro:if>


		</link>

		<joint name="${prefix}joint2" type="revolute">
			<origin rpy="${direction * 1.5707999999999998} 0.0 -3.1415853071795863"/>
			<parent link="${prefix}link1"/>
			<child link="${prefix}link2"/>
			<axis xyz="0.0 0.0 ${direction}"/>
			<limit lower="${-2.007 if float(direction) > 0.0 else -1.7453}"
			       upper="${1.7453 if float(direction) > 0.0 else 2.007}" effort="1000.0" velocity="1.5"/>
		</joint>

		<link name="${prefix}link3">
			<visual>
				<geometry>
					<mesh filename="file://$(find galbot_s1_description)/meshes/visual/arm/link3.glb" scale="1 ${direction} 1"/>
				</geometry>
			</visual>


			<inertial>
				<origin xyz="0.00462 0.0053 -0.05933"/>
				<mass value="5.15"/>
				<inertia ixx="0.06880491999999999" ixy="2.58e-05" ixz="0.00275911"
				         iyy="0.06985521" iyz="3.47e-05" izz="0.01030719"/>
			</inertial>
			<xacro:if value="${collision_type == 'simple'}">
				<collision name="S1_${name}_arm_link_3_collision01_cyl">
					<origin xyz="-1.2394040822982788e-05 ${direction * 7.450580596923828e-09} -0.2360723316669464"
					        rpy="3.1415901184081 0.0 0.0"/>
					<geometry>
						<cylinder length="0.053852006793022156" radius="0.06129998713731766"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_3_collision02_box">
					<origin xyz="0.014640449546277523 ${direction * -0.0008858982473611832} -0.13378310203552246"/>
					<geometry>
						<box size="0.06603563576936722 0.10413718223571777 0.12956443428993225"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_3_collision03_cyl">
					<origin xyz="-1.6259082968872463e-08 ${direction * 1.545622944831848e-05} 1.889355303319462e-07"
					        rpy="-1.5707962512969953 -1.50995809633514e-07 1.5099579830923915e-07"/>
					<geometry>
						<cylinder length="0.10240488499403" radius="0.06561815738677979"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collision_type == 'convex_decomposition'}">
				<collision>
					<geometry>
						<mesh
								filename="file://$(find galbot_s1_description)/meshes/collision/convex_decomposition/arm/link3_0.stl"
								scale="1 ${direction} 1"/>
					</geometry>
				</collision>
			</xacro:if>


		</link>

		<joint name="${prefix}joint3" type="revolute">
			<origin xyz="0.0 ${direction * 0.49} 0.0"
			        rpy="${direction * 1.5708000000000002} 1.0472000000000001 -3.1415853071795863"/>
			<parent link="${prefix}link2"/>
			<child link="${prefix}link3"/>
			<axis xyz="0.0 0.0 ${direction}"/>
			<limit lower="-2.9496" upper="2.9496" effort="1000.0" velocity="1.5"/>
		</joint>

		<link name="${prefix}link4">
			<visual>
				<geometry>
					<mesh filename="file://$(find galbot_s1_description)/meshes/visual/arm/link4.glb" scale="1 ${direction} 1"/>
				</geometry>
			</visual>


			<inertial>
				<origin xyz="-2e-05 -0.10447 0.00156"/>
				<mass value="2.65"/>
				<inertia ixx="0.043397309999999995" ixy="8.900000000000001e-06" ixz="2.906e-05"
				         iyy="0.00687065" iyz="0.00016217" izz="0.04026515"/>
			</inertial>
			<xacro:if value="${collision_type == 'simple'}">
				<collision name="S1_${name}_arm_link_4_collision01_cyl">
					<origin xyz="3.65618834621273e-05 ${direction * -0.13237044215202332} -0.0004974534385837615"
					        rpy="-1.5709412097923003 -9.237948768614501e-06 9.239286281825798e-06"/>
					<geometry>
						<cylinder length="0.09627343714237213" radius="0.049506187438964844"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_4_collision02_box">
					<origin xyz="-0.005392866209149361 ${direction * -0.09557770192623138} 0.0007550381124019623"/>
					<geometry>
						<box size="0.08770489692687988 0.06547445803880692 0.15127581357955933"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_4_collision03_box">
					<origin xyz="-7.450580596923828e-09 ${direction * 0.0060995761305093765} 0.0651610866189003"/>
					<geometry>
						<box size="0.131892591714859 0.12001502513885498 0.023299802094697952"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_4_collision04_box">
					<origin xyz="-9.177625179290771e-05 ${direction * 0.004184126853942871} -0.058025963604450226"/>
					<geometry>
						<box size="0.1317090541124344 0.12384374439716339 0.03269955888390541"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collision_type == 'convex_decomposition'}">
				<collision>
					<geometry>
						<mesh
								filename="file://$(find galbot_s1_description)/meshes/collision/convex_decomposition/arm/link4_0.stl"
								scale="1 ${direction} 1"/>
					</geometry>
				</collision>
				<collision>
					<geometry>
						<mesh
								filename="file://$(find galbot_s1_description)/meshes/collision/convex_decomposition/arm/link4_1.stl"
								scale="1 ${direction} 1"/>
					</geometry>
				</collision>
			</xacro:if>


		</link>

		<joint name="${prefix}joint4" type="revolute">
			<origin rpy="${-direction * 1.5708} 0.0 0.0"/>
			<parent link="${prefix}link3"/>
			<child link="${prefix}link4"/>
			<axis xyz="0.0 0.0 ${direction}"/>
			<limit lower="${-1.92 if float(direction) > 0.0 else -2.618}"
			       upper="${2.618 if float(direction) > 0.0 else 1.9199}" effort="1000.0" velocity="1.5"/>
		</joint>

		<link name="${prefix}link5">
			<visual>
				<geometry>
					<mesh filename="file://$(find galbot_s1_description)/meshes/visual/arm/link5.glb" scale="${direction} 1 1"/>
				</geometry>
			</visual>


			<inertial>
				<origin xyz="0.001 0.00816 -0.15343"/>
				<mass value="2.68"/>
				<inertia ixx="0.07626529" ixy="0.00014333000000000003" ixz="0.00017779"
				         iyy="0.07438588" iyz="0.00328718" izz="0.00456926"/>
			</inertial>
			<xacro:if value="${collision_type == 'simple'}">
				<collision name="S1_${name}_arm_link_5_collision01_cyl">
					<origin xyz="-3.5259872674942017e-06 ${direction * 0.002517879009246826} -0.1700008511543274"
					        rpy="-1.5707962512969948 -8.742278367890322e-08 8.742277712858737e-08"/>
					<geometry>
						<cylinder length="0.11577604711055756" radius="0.044835153967142105"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_5_collision02_cyl">
					<origin xyz="-4.047138588703092e-07 ${direction * 7.816246943548322e-05} -0.21207471191883087"
					        rpy="8.946753872242225e-06 -1.0964599624241345e-05 6.187575679692664e-18"/>
					<geometry>
						<cylinder length="0.07280264049768448" radius="0.049000006169080734"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_5_collision03_box">
					<origin xyz="-0.00015054643154144287 ${direction * -0.055761806666851044} -0.02595461905002594"/>
					<geometry>
						<box size="0.06586866080760956 0.024762198328971863 0.11810524761676788"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_5_collision04_box">
					<origin xyz="-0.0009217914193868637 ${direction * 0.0003292746841907501} -0.10156498849391937"/>
					<geometry>
						<box size="0.03957314044237137 0.1269444227218628 0.04331596940755844"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_5_collision05_box">
					<origin xyz="0.003745594061911106 ${direction * 0.0524803027510643} -0.03243480250239372"/>
					<geometry>
						<box size="0.048322178423404694 0.02263958752155304 0.10410236567258835"/>
					</geometry>
				</collision>
				<collision name="S1_${name}_arm_link_5_collision06_box">
					<origin xyz="0.038913484662771225 ${direction * 0.05739441514015198} -0.08359698206186295"/>
					<geometry>
						<box size="0.02188674360513687 0.022900041192770004 0.19973422586917877"/>
					</geometry>
				</collision>

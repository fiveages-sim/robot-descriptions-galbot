<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:macro name="Arm" params="name direction:=1">

		<xacro:property name="prefix" value="${name + '_' if name else ''}"/>

		<link name="${prefix}base_link">
			<inertial>
				<origin xyz="0.0 0.0 -0.10506"/>
				<mass value="0.92"/>
				<inertia ixx="0.01075595" ixy="9e-08" ixz="4.1e-07" iyy="0.01077842" iyz="1.896e-05"
								 izz="0.0007042000000000001"/>
			</inertial>
		</link>

		<link name="${prefix}link1">
			<inertial>
				<origin xyz="0.0 ${direction*0.0009699999999999999} -0.015390000000000001"/>
				<mass value="1.6"/>
				<inertia ixx="0.00332981" ixy="1.8920000000000002e-05" ixz="6.9e-07" iyy="0.00339121"
								 iyz="2.9760000000000003e-05" izz="0.0016524"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find galbot_foxtrot_description)/meshes/visual/arm/link1.obj"
								scale="1 ${direction} 1"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find galbot_foxtrot_description)/meshes/collision/arm/link1.stl"
								scale="1 ${direction} 1"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}joint1" type="revolute">
			<origin rpy="0 0 ${direction*0.523598775598286}"/>
			<parent link="${prefix}base_link"/>
			<child link="${prefix}link1"/>
			<axis xyz="0 0 ${direction}"/>
			<limit acceleration="2" effort="60" jerk="12" lower="-3.0043" upper="3.0043" velocity="1.5"/>
		</joint>

		<link name="${prefix}link2">
			<inertial>
				<origin xyz="0.0 ${direction*0.09558} 0.010150000000000001"/>
				<mass value="1.43"/>
				<inertia ixx="0.01937881" ixy="2.0000000000000002e-07" ixz="1.2e-07" iyy="0.0015791400000000001"
								 iyz="0.00019578"
								 izz="0.018951810000000003"/>
			</inertial>
			<visual>
				<geometry>
					<mesh
							filename="file://$(find galbot_foxtrot_description)/meshes/visual/arm/link2.obj"
							scale="1 ${direction} 1"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh
							filename="file://$(find galbot_foxtrot_description)/meshes/collision/arm/link2.stl"
							scale="1 ${direction} 1"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}joint2" type="revolute">
			<origin rpy="${direction*1.5707963267949} 0 3.14159265358979"/>
			<parent link="${prefix}link1"/>
			<child link="${prefix}link2"/>
			<axis xyz="0 0 ${direction}"/>
			<limit acceleration="2" effort="60" jerk="12" lower="-1.6081" upper="1.6081" velocity="1.5"/>
		</joint>

		<link name="${prefix}link3">
			<inertial>
				<origin xyz="0.0 ${direction*0.00088} -0.04936"/>
				<mass value="1.43"/>
				<inertia ixx="0.01187457" ixy="1.5e-07" ixz="8.5e-07" iyy="0.01178759" iyz="0.00010048" izz="0.0013715"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find galbot_foxtrot_description)/meshes/visual/arm/link3.obj"
								scale="1 ${direction} 1"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find galbot_foxtrot_description)/meshes/collision/arm/link3.stl"
								scale="1 ${direction} 1"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}joint3" type="revolute">
			<origin rpy="${direction*1.5707963267949} 1.04719755119629 -3.14159265358979" xyz="0 ${direction*0.35} 0"/>
			<parent link="${prefix}link2"/>
			<child link="${prefix}link3"/>
			<axis xyz="0 0 ${direction}"/>
			<limit acceleration="2" effort="30" jerk="12" lower="-2.91697" upper="2.91697" velocity="1.5"/>
		</joint>

		<link name="${prefix}link4">
			<inertial>
				<origin xyz="0.0 ${direction*0.05614} 0.019170000000000003"/>
				<mass value="1.1"/>
				<inertia ixx="0.00701388" ixy="3.2e-07" ixz="1.16e-06" iyy="0.00161854" iyz="0.00033944"
								 izz="0.0065011999999999995"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find galbot_foxtrot_description)/meshes/visual/arm/link4.obj"
								scale="1 ${direction} 1"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find galbot_foxtrot_description)/meshes/collision/arm/link4.stl"
								scale="1 ${direction} 1"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}joint4" type="revolute">
			<origin rpy="${direction*1.57079632679459} 0 3.14159265358979"/>
			<parent link="${prefix}link3"/>
			<child link="${prefix}link4"/>
			<axis xyz="0 0 ${-direction}"/>
			<limit acceleration="2" effort="30" jerk="12" lower="-1.86986" upper="2.56799" velocity="1.5"/>
		</joint>

		<link name="${prefix}link5">
			<inertial>
				<origin xyz="0.00044 0.0016899999999999999 -0.13306"/>
				<mass value="1.15"/>
				<inertia ixx="0.025809930000000002" ixy="1.98e-05" ixz="5.605e-05" iyy="0.02530313" iyz="0.00020931999999999998"
								 izz="0.00115848"/>
			</inertial>
			<visual>
				<geometry>
					<mesh
							filename="file://$(find galbot_foxtrot_description)/meshes/visual/arm/link5.obj"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh
							filename="file://$(find galbot_foxtrot_description)/meshes/collision/arm/link5.stl"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}joint5" type="revolute">
			<origin rpy="-1.5707963267949 0 ${direction*-1.5707963267949 + 1.5707963267949}" xyz="0 ${direction*0.36} 0"/>
			<parent link="${prefix}link4"/>
			<child link="${prefix}link5"/>
			<axis xyz="0 0 ${direction}"/>
			<limit acceleration="2" effort="10" jerk="12" lower="-2.91697" upper="2.91697" velocity="1.5"/>
		</joint>

		<link name="${prefix}link6">
			<inertial>
				<origin xyz="-0.00088 ${direction*-0.0072699999999999996} -0.00011999999999999999"/>
				<mass value="0.47"/>
				<inertia ixx="0.00027557" ixy="7.6e-07" ixz="1.44e-06" iyy="0.00028977999999999995" iyz="2.25e-06"
								 izz="0.00029684"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find galbot_foxtrot_description)/meshes/visual/arm/link6.obj"
								scale="1 ${direction} 1"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find galbot_foxtrot_description)/meshes/collision/arm/link6.stl"
								scale="1 ${direction} 1"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}joint6" type="revolute">
			<origin rpy="1.5707963267949 1.5707963267949 0"/>
			<parent link="${prefix}link5"/>
			<child link="${prefix}link6"/>
			<axis xyz="0 0 ${direction}"/>
			<limit acceleration="2" effort="10" jerk="12" lower="-0.7354" upper="0.8227" velocity="1.5"/>
		</joint>

		<link name="${prefix}link7">
			<inertial>
				<origin xyz="-0.05751 ${direction*-0.00684} 0.011869999999999999"/>
				<mass value="0.8"/>
				<inertia ixx="0.00117613" ixy="0.00033793" ixz="0.0001662" iyy="0.00423935" iyz="8.589999999999999e-06"
								 izz="0.00417642"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find galbot_foxtrot_description)/meshes/visual/arm/link7.obj"
								scale="1 ${direction} 1"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find galbot_foxtrot_description)/meshes/collision/arm/link7.stl"
								scale="1 ${direction} 1"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}joint7" type="revolute">
			<origin rpy="${direction*1.5707963267949} 0 0"/>
			<parent link="${prefix}link6"/>
			<child link="${prefix}link7"/>
			<axis xyz="0 0 ${direction}"/>
			<limit acceleration="2" effort="10" jerk="12" lower="-1.5382" upper="1.5382" velocity="1.5"/>
		</joint>

		<joint name="${prefix}camera_joint" type="fixed">
			<parent link="${prefix}link7"/>
			<child link="${prefix}wrist_camera_link"/>
		</joint>

		<link name="${prefix}wrist_camera_link">
			<inertial>
				<origin xyz="-0.0621229724155358 -0.0628379837355285 -0.00140310958315455"/>
				<mass value="0.0492751941348016"/>
				<inertia ixx="3.66069470547417E-05" ixy="-3.55284385731841E-07" ixz="3.8533182318026E-07"
								 iyy="3.08593710158624E-05" iyz="-3.07292981503681E-07" izz="8.80145863410975E-06"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find galbot_foxtrot_description)/meshes/visual/arm/d405_stand.obj"/>
				</geometry>
			</visual>
			<visual>
				<origin xyz="-0.0822 0 -0.06842" rpy="-1.5708 3.2315926 0"/>
				<geometry>
					<mesh filename="file://$(find sensor_models)/meshes/d405/d405.obj"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find galbot_foxtrot_description)/meshes/collision/d405.stl"/>
				</geometry>
			</collision>
		</link>
	</xacro:macro>
</robot>

<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="PI" value="3.141592653589793"/>
    <xacro:property name="collider_type" value="$(arg collider)"/>
    <xacro:arg name="enable_joint5" default="false"/>
    <joint name="leg_joint" type="fixed">
        <parent link="omni_chassis_leg_mount_link"/>
        <child link="leg_base_link"/>
    </joint>

    <link name="leg_base_link">
        <inertial>
            <origin xyz="7.000000000000001e-05 -0.05414 0.0"/>
            <mass value="1.58"/>
            <inertia ixx="0.00797474" ixy="8.35e-06" ixz="2e-08" iyy="0.00248067" iyz="6.9e-07" izz="0.00797203"/>
        </inertial>
    </link>

    <link name="leg_link1">
        <inertial>
            <origin xyz="0.21883000000000002 0.00219 -0.0046"/>
            <mass value="5.28"/>
            <inertia ixx="0.0245158" ixy="0.003598" ixz="-0.004119" iyy="0.46437793" iyz="2.301e-05" izz="0.46079615"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="file://$(find galbot_foxtrot_description)/meshes/visual/leg/leg1.glb"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="file://$(find galbot_foxtrot_description)/meshes/collision/leg/link1.stl"/>
            </geometry>
        </collision>
    </link>

    <joint name="body_joint1" type="revolute">
        <origin rpy="${PI/2} -0.385 ${PI}"/>
        <parent link="leg_base_link"/>
        <child link="leg_link1"/>
        <axis xyz="0 0 1"/>
        <limit effort="169" lower="0.0" upper="0.9374" velocity="1"/>
    </joint>

    <link name="leg_link2">
        <inertial>
            <origin xyz="0.19484 0.0 0.0"/>
            <mass value="3.3"/>
            <inertia ixx="0.04156241" ixy="7.2e-07" ixz="1.559e-05" iyy="0.23231617000000002"
                     iyz="-2.7799999999999996e-06"
                     izz="0.20323657"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="file://$(find galbot_foxtrot_description)/meshes/visual/leg/leg2.glb"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="file://$(find galbot_foxtrot_description)/meshes/collision/leg/link2.stl"/>
            </geometry>
        </collision>
    </link>

    <joint name="body_joint2" type="revolute">
        <origin rpy="${PI} 0 2.7566" xyz="0.45 0 0"/>
        <parent link="leg_link1"/>
        <child link="leg_link2"/>
        <axis xyz="0 0 1"/>
        <limit effort="169" lower="0.0" upper="2.5847" velocity="1"/>
    </joint>

    <link name="leg_link3">
        <inertial>
            <origin xyz="2e-05 0.01881 -0.011"/>
            <mass value="1.76"/>
            <inertia ixx="0.01102444" ixy="1.13e-06" ixz="-1.26e-06" iyy="0.00878281" iyz="1.26e-06" izz="0.0106222"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="file://$(find galbot_foxtrot_description)/meshes/visual/leg/leg3.glb"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="file://$(find galbot_foxtrot_description)/meshes/collision/leg/link3.stl"/>
            </geometry>
        </collision>
    </link>

    <joint name="body_joint3" type="revolute">
        <origin rpy="${PI} 0 ${PI}" xyz="0.39 0 0"/>
        <parent link="leg_link2"/>
        <child link="leg_link3"/>
        <axis xyz="0 0 1"/>
        <limit effort="84" lower="0.0" upper="2.3262" velocity="1"/>
    </joint>

    <link name="leg_link4">
        <inertial>
            <origin xyz="0.0 -0.0059900000000000005 -0.06877"/>
            <mass value="0.72"/>
            <inertia ixx="0.00580757" ixy="0.0" ixz="0.0" iyy="0.00591483" iyz="4.67e-06" izz="0.0014004900000000001"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="file://$(find galbot_foxtrot_description)/meshes/visual/leg/leg4.glb"/>
            </geometry>
        </visual>
    </link>

    <joint name="body_joint4" type="revolute">
        <origin rpy="-${PI/2} -${PI/2} 0" xyz="0 0.224 0"/>
        <parent link="leg_link3"/>
        <child link="leg_link4"/>
        <axis xyz="0 0 1"/>
        <limit effort="30" lower="-1.5906" upper="1.5906" velocity="1"/>
    </joint>

    <xacro:if value="$(arg enable_joint5)">
        <link name="leg_link5">
            <inertial>
                <origin xyz="0.0 0.032369999999999996 0.03006"/>
                <mass value="0.41"/>
                <inertia ixx="0.00142201" ixy="0.0" ixz="0.0" iyy="0.00132398" iyz="0.00023940999999999999"
                         izz="0.00156199"/>
            </inertial>
        </link>

        <joint name="body_joint5" type="revolute">
            <origin rpy="${PI/2} 0 0"/>
            <parent link="leg_link4"/>
            <child link="leg_link5"/>
            <axis xyz="0 0 1"/>
            <limit effort="30" lower="-0.1645" upper="0.1645" velocity="1"/>
        </joint>

        <link name="leg_end_effector_mount_link"/>
        <joint name="leg_end_effector_mount_joint" type="fixed">
            <parent link="leg_link5"/>
            <child link="leg_end_effector_mount_link"/>
        </joint>
    </xacro:if>

    <xacro:unless value="$(arg enable_joint5)">
        <link name="leg_end_effector_mount_link">
            <inertial>
                <origin xyz="0.0 0.032369999999999996 0.03006"/>
                <mass value="0.41"/>
                <inertia ixx="0.00142201" ixy="0.0" ixz="0.0" iyy="0.00132398" iyz="0.00023940999999999999"
                         izz="0.00156199"/>
            </inertial>
        </link>

        <joint name="leg_end_effector_mount_joint" type="fixed">
            <origin rpy="${PI/2} 0 0"/>
            <parent link="leg_link4"/>
            <child link="leg_end_effector_mount_link"/>
        </joint>
    </xacro:unless>

    <joint name="torso_joint" type="fixed">
        <parent link="leg_end_effector_mount_link"/>
        <child link="torso_base_link"/>
    </joint>

    <link name="torso_base_link">
        <inertial>
            <origin xyz="-4e-05 0.16976 -0.00174"/>
            <mass value="3.3"/>
            <inertia ixx="0.13068739999999998" ixy="-3.799e-05" ixz="2.6e-07" iyy="0.01888968" iyz="-0.00210909"
                     izz="0.13964288"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="file://$(find galbot_foxtrot_description)/meshes/visual/torso/torso.glb"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="file://$(find galbot_foxtrot_description)/meshes/collision/torso.stl"/>
            </geometry>
        </collision>
    </link>

</robot>

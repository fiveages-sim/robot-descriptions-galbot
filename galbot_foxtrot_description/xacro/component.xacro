<?xml version="1.0" ?>
<robot name="Arms_Default" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="PI" value="3.141592653589793"/>
  <xacro:arg name="type" default="base"/>
  <xacro:arg name="enable_wheel_joints" default="true"/>
  <xacro:arg name="collider" default="simple"/>

  <xacro:if value="${'$(arg type)' == 'base'}">
    <xacro:include filename="$(find galbot_one_description)/xacro/components/chassis.xacro"/>
    <xacro:include filename="$(find galbot_one_description)/xacro/components/body.xacro"/>
    <xacro:GalbotOneChassis enable_wheel_joints="true"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'wheel'}">
    <!-- Include Wheel -->
    <xacro:include filename="$(find component_models)/xacro/angellun_200.xacro"/>
    <xacro:wheel wheel_name="wheel" enable_passive_wheels="true"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'chassis'}">
    <xacro:include filename="$(find galbot_foxtrot_description)/xacro/components/chassis.xacro"/>
    <xacro:GalbotChassisV2 enable_wheel_joints="true"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'body'}">
    <link name="base_link"/>
    <joint name="base_joint" type="fixed">
      <parent link="base_link"/>
      <child link="omni_chassis_leg_mount_link"/>
    </joint>
    <link name="omni_chassis_leg_mount_link"/>
    <xacro:include filename="$(find galbot_one_description)/xacro/components/body.xacro"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'head'}">
    <link name="base_link"/>
    <xacro:include filename="$(find galbot_foxtrot_description)/xacro/components/head.xacro"/>
    <xacro:galbot_foxtrot_head parent_link="base_link"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'arm'}">
    <xacro:include filename="$(find galbot_foxtrot_description)/xacro/components/arm.xacro"/>
    <link name="arm_base"/>

    <joint name="torso_left_mount_joint" type="fixed">
      <origin rpy="0 1.5707963267948966 0" xyz="0.20843 0 0"/>
      <parent link="arm_base"/>
      <child link="left_base_link"/>
    </joint>

    <joint name="torso_right_mount_joint" type="fixed">
      <origin rpy="3.141592653589793 1.5707963267948966 0" xyz="-0.20843 0 0"/>
      <parent link="arm_base"/>
      <child link="right_base_link"/>
    </joint>

    <xacro:Arm name="right" direction="-1" camera="none"/>
    <xacro:Arm name="left" camera="none"/>

  </xacro:if>
</robot>

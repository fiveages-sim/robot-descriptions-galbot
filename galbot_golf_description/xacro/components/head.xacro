<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:property name="PI" value="3.141592653589793"/>

	<xacro:macro name="galbot_golf_head" params="parent_link">
		<!-- Head Mount -->
		<link name="torso_head_mount_link"/>
		<joint name="torso_head_mount_joint" type="fixed">
			<origin rpy="-1.5707963267948966 -1.5707963267948966 0" xyz="0 0.37711 0"/>
			<parent link="${parent_link}"/>
			<child link="torso_head_mount_link"/>
			<axis/>
		</joint>

		<joint name="head_joint" type="fixed">
			<parent link="torso_head_mount_link"/>
			<child link="head_base_link"/>
		</joint>

		<link name="head_base_link">
			<inertial>
				<origin xyz="0.023809999999999998 0.00032 0.01966"/>
				<mass value="0.48"/>
				<inertia ixx="0.0032910599999999997" ixy="8.32e-06" ixz="0.00044358" iyy="0.00375998" iyz="7.18e-06"
								 izz="0.00221683"/>
			</inertial>
		</link>
		<link name="head_link1">
			<inertial>
				<origin xyz="-2e-05 0.00709 -0.0559"/>
				<mass value="1.5695"/>
				<inertia ixx="0.0069002956" ixy="0.00000152205" ixz="0.00000313295" iyy="0.00683300359" iyz="0.00001009318"
								 izz="0.00116967635"/>
			</inertial>
		</link>

		<joint name="head_joint1" type="revolute">
			<parent link="head_base_link"/>
			<child link="head_link1"/>
			<axis xyz="0 0 1"/>
			<limit effort="4" lower="-1.5208" upper="1.5208" velocity="1.5"/>
		</joint>

		<link name="head_link2">
			<inertial>
				<origin xyz="0.01835 -0.033479999999999996 0.00642"/>
				<mass value="0.81"/>
				<inertia ixx="0.00000399161" ixy="0.00000129825" ixz="0.00000000392" iyy="0.00000372602" iyz="0.00000000775"
								 izz="0.00000553062"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find galbot_golf_description)/meshes/visual/head/head.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find galbot_golf_description)/meshes/collision/head.stl"/>
				</geometry>
			</collision>
		</link>

		<joint name="head_joint2" type="revolute">
			<origin rpy="-1.5707963267948966 0 0"/>
			<parent link="head_link1"/>
			<child link="head_link2"/>
			<axis xyz="0 0 1"/>
			<limit effort="4" lower="-0.2143461" upper="0.4935988" velocity="1.5"/>
		</joint>

		<link name="head_end_effector_mount_link"/>
		<joint name="head_end_effector_mount_joint" type="fixed">
			<parent link="head_link2"/>
			<child link="head_end_effector_mount_link"/>
			<axis/>
		</joint>
	</xacro:macro>
</robot>

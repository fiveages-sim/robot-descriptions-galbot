<?xml version="1.0" ?>

<robot name="galbot_one_golf" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:arg name="enable_wheel_joints" default="false"/>
	<xacro:arg name="arm_camera" default="d405"/>
	<xacro:arg name="enable_joint5" default="true"/>
	<xacro:arg name="collider" default="simple"/>
	<xacro:arg name="enable_suction_rotation" default="false"/>
	<xacro:arg name="eef_fixed_joints" default="false"/>
	<!-- type: galbot_gripper | hitbot | suction_cup | none (default EE for both arms) -->
	<xacro:arg name="type" default="galbot_gripper"/>
	<xacro:arg name="left_type" default=""/>
	<xacro:arg name="right_type" default=""/>

	<xacro:include filename="$(find galbot_foxtrot_description)/xacro/components/body.xacro"/>
	<xacro:include filename="$(find galbot_golf_description)/xacro/components/head.xacro"/>
	<xacro:include filename="$(find galbot_foxtrot_description)/xacro/components/arm.xacro"/>
	<xacro:include filename="$(find galbot_foxtrot_description)/xacro/components/chassis.xacro"/>
	<xacro:include filename="$(find galbot_foxtrot_description)/xacro/components/end_effector.xacro"/>
	<xacro:InitGalbotEeTypes type="$(arg type)" left_type_arg="$(arg left_type)"
	                       right_type_arg="$(arg right_type)"/>

	<xacro:GalbotChassisV2 enable_wheel_joints="$(arg enable_wheel_joints)"/>
	<xacro:galbot_golf_head parent_link="torso_base_link"/>

	<link name="torso_left_arm_mount_link"/>
	<joint name="torso_left_arm_mount_joint" type="fixed">
		<origin rpy="0 1.5707963267948966 0" xyz="0.20843 0.172 0"/>
		<parent link="torso_base_link"/>
		<child link="torso_left_arm_mount_link"/>
		<axis/>
	</joint>

	<link name="torso_right_arm_mount_link"/>
	<joint name="torso_right_arm_mount_joint" type="fixed">
		<origin rpy="3.141592653589793 1.5707963267948966 0" xyz="-0.20843 0.172 0"/>
		<parent link="torso_base_link"/>
		<child link="torso_right_arm_mount_link"/>
		<axis/>
	</joint>

	<joint name="right_arm_joint" type="fixed">
		<parent link="torso_right_arm_mount_link"/>
		<child link="right_base_link"/>
	</joint>
	<xacro:Arm name="right" direction="-1" camera="$(arg arm_camera)"/>
	<xacro:GalbotArmEndEffector name="right" ee_type="${selected_right_ee_type}" variant="foxtrot"
	                            collider="$(arg collider)"
	                            enable_suction_rotation="$(arg enable_suction_rotation)"
	                            eef_fixed_joints="$(arg eef_fixed_joints)"/>

	<joint name="left_arm_joint" type="fixed">
		<parent link="torso_left_arm_mount_link"/>
		<child link="left_base_link"/>
	</joint>
	<xacro:Arm name="left" camera="$(arg arm_camera)"/>
	<xacro:GalbotArmEndEffector name="left" ee_type="${selected_left_ee_type}" variant="foxtrot"
	                            collider="$(arg collider)"
	                            enable_suction_rotation="$(arg enable_suction_rotation)"
	                            eef_fixed_joints="$(arg eef_fixed_joints)"/>
</robot>

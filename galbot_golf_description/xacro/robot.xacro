<?xml version="1.0" ?>

<robot name="galbot_one_golf" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:arg name="enable_wheel_joints" default="false"/>
	<xacro:property name="PI" value="3.141592653589793"/>

	<xacro:include filename="$(find galbot_foxtrot_description)/xacro/galbot_gripper.xacro"/>
	<xacro:include filename="$(find galbot_golf_description)/xacro/components/body.xacro"/>
	<xacro:include filename="$(find galbot_foxtrot_description)/xacro/arm.xacro"/>

	<xacro:include filename="$(find galbot_foxtrot_description)/xacro/components/chassis.xacro"/>
	<xacro:GalbotChassisV2 enable_wheel_joints="$(arg enable_wheel_joints)"/>

	<!-- Left Arm Mount -->
	<link name="torso_left_arm_mount_link"/>
	<joint name="torso_left_arm_mount_joint" type="fixed">
		<origin rpy="0 1.5707963267948966 0" xyz="0.20843 0.172 0"/>
		<parent link="torso_base_link"/>
		<child link="torso_left_arm_mount_link"/>
		<axis/>
	</joint>

	<!-- Right Arm Mount -->
	<link name="torso_right_arm_mount_link"/>
	<joint name="torso_right_arm_mount_joint" type="fixed">
		<origin rpy="3.141592653589793 1.5707963267948966 0" xyz="-0.20843 0.172 0"/>
		<parent link="torso_base_link"/>
		<child link="torso_right_arm_mount_link"/>
		<axis/>
	</joint>

	<joint name="right_arm_joint" type="fixed">
		<parent link="torso_right_arm_mount_link"/>
		<child link="right_base_link"/>
	</joint>

	<xacro:Arm name="right" direction="-1"/>

	<joint name="right_arm_end_effector_mount_joint" type="fixed">
		<origin rpy="-1.5708 0 3.14159265358948" xyz="-0.10926 0 0"/>
		<parent link="right_link7"/>
		<child link="right_gripper_flange"/>
		<axis/>
	</joint>

	<xacro:Gripper name="right"/>

	<joint name="left_arm_joint" type="fixed">
		<parent link="torso_left_arm_mount_link"/>
		<child link="left_base_link"/>
	</joint>

	<xacro:Arm name="left"/>

	<joint name="left_arm_end_effector_mount_joint" type="fixed">
		<origin rpy="-1.5708 0 3.14159265358979" xyz="-0.10926 0 0"/>
		<parent link="left_link7"/>
		<child link="left_gripper_flange"/>
	</joint>
	<xacro:Gripper name="left"/>
</robot>

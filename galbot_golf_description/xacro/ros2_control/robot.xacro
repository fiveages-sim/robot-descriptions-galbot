<?xml version="1.0" ?>
<!-- =================================================================================== -->
<!-- |    Complete Robot Description for Galbot Foxtrot                                     | -->
<!-- |    This file includes the base robot structure and both arms                    | -->
<!-- =================================================================================== -->
<robot name="genie" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!-- Include the base robot structure -->
	<xacro:include filename="$(find galbot_golf_description)/xacro/robot.xacro"/>

	<!-- Import modular interface components -->
	<xacro:include filename="$(find galbot_golf_description)/xacro/ros2_control/base_interfaces.xacro"/>
	<xacro:include filename="$(find galbot_foxtrot_description)/xacro/ros2_control/head_interfaces.xacro"/>
	<xacro:include filename="$(find galbot_foxtrot_description)/xacro/ros2_control/arm_interfaces.xacro"/>
	<xacro:property name="gripper_initial_value" value="1.57"/>
	<xacro:if value="${'$(arg type)' == 'hitbot'}">
		<xacro:property name="gripper_initial_value" value="0.75"/>
	</xacro:if>

	<!-- Unified ros2_control system -->
	<ros2_control name="galbot_golf_unified_system" type="system">
		<hardware>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
				<plugin>gz_ros2_control/GazeboSimSystem</plugin>
			</xacro:if>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
				<plugin>mock_components/GenericSystem</plugin>
			</xacro:if>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
				<plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
				<param name="joint_commands_topic">/isaac/joint_command</param>
				<param name="joint_states_topic">/isaac/joint_states</param>
			</xacro:if>
		</hardware>

		<!-- 基座接口 -->
		<xacro:base_interfaces/>

		<!-- 头部接口 -->
		<xacro:head_interfaces/>

		<!-- 左臂接口 -->
		<xacro:arm_interfaces name="left" gripper_initial_value="${gripper_initial_value}"/>

		<!-- 右臂接口 -->
		<xacro:arm_interfaces name="right" gripper_initial_value="${gripper_initial_value}"/>
	</ros2_control>

	<xacro:arg name="gazebo" default="false" />
	<xacro:if value="$(arg gazebo)">
		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<parameters>$(find galbot_foxtrot_description)/config/ros2_control/ros2_controllers.yaml</parameters>
			</plugin>
		</gazebo>
	</xacro:if>
</robot>

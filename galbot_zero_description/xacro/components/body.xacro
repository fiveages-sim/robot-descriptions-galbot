<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="GalbotZeroBody">
        <joint name="body_torsor_joint" type="fixed">
            <origin rpy="0 0 3.141592653589793"/>
            <parent link="hexman_chassis_lift_fix_point_link"/>
            <child link="lift_base_link"/>
        </joint>

        <link name="lift_base_link">
            <inertial>
                <origin xyz="-0.02579 8.6701E-05 0.40292"/>
                <mass value="6.2299"/>
                <inertia ixx="0.29388" ixy="-3.7312E-07" ixz="-7.8474E-05" iyy="0.28323" iyz="-3.0503E-05"
                         izz="0.014664"/>
            </inertial>

            <visual>
                <geometry>
                    <mesh filename="file://$(find galbot_zero_description)/meshes/body/base.glb"/>
                </geometry>
            </visual>

            <collision>
                <origin xyz="-0.02579 8.6701E-05 0.48692"/>
                <geometry>
                    <box size=" 0.171  0.248 0.98"/>
                </geometry>
            </collision>
        </link>

        <link name="body_lift_link">
            <inertial>
                <origin xyz="-0.042686 -1.1977E-05 0.16212"/>
                <mass value="3.3336"/>
                <inertia ixx="0.025094" ixy="6.0022E-07" ixz="0.0002003" iyy="0.02006" iyz="1.6489E-06"
                         izz="0.0091015"/>
            </inertial>

            <visual>
                <geometry>
                    <mesh filename="file://$(find galbot_zero_description)/meshes/body/body.glb"/>
                </geometry>
            </visual>

            <collision>
                <origin xyz="-0.06 0  0.16212 "/>
                <geometry>
                    <box size=" 0.11  0.18 0.47"/>
                </geometry>
            </collision>
        </link>

        <joint name="body_lift_joint" type="prismatic">
            <origin xyz="-0.1015 0 0.14"/>
            <parent link="lift_base_link"/>
            <child link="body_lift_link"/>
            <axis xyz="0 0 1"/>
            <limit effort="60" lower="0" upper="0.75" velocity="0.15"/>
        </joint>

        <joint name="head_joint" type="fixed">
            <origin rpy=" 0 0 3.141592653589793 " xyz="-0.05 0 0.398"/>
            <parent link="body_lift_link"/>
            <child link="head_link"/>
        </joint>

        <link name="head_link">
            <inertial>
                <origin xyz="2.8174E-05 4.4192E-05 0.026611"/>
                <mass value="0.34013"/>
                <inertia ixx="0.00017046" ixy="-1.5263E-08" ixz="2.7006E-07" iyy="0.00023937" iyz="4.4134E-07"
                         izz="0.00023946"/>
            </inertial>

            <visual>
                <geometry>
                    <mesh filename="file://$(find galbot_zero_description)/meshes/head/head_link.glb"/>
                </geometry>
            </visual>

            <collision>
                <geometry>
                    <mesh filename="file://$(find galbot_zero_description)/meshes/head/head_link.glb"/>
                </geometry>
            </collision>
        </link>

        <link name="head_yaw_link">
            <inertial>
                <origin xyz="0.060943 -0.0042049 0.013422"/>
                <mass value="0.3007"/>
                <inertia ixx="0.00017407" ixy="5.4933E-07" ixz="1.9726E-07" iyy="0.0002335" iyz="-4.3666E-07"
                         izz="0.00023763"/>
            </inertial>

            <visual>
                <geometry>
                    <mesh filename="file://$(find galbot_zero_description)/meshes/head/head_yaw.glb"/>
                </geometry>
            </visual>

            <collision>
                <geometry>
                    <mesh filename="file://$(find galbot_zero_description)/meshes/head/head_yaw.glb"/>
                </geometry>
            </collision>
        </link>

        <joint name="head_joint1" type="revolute">
            <origin xyz="0 0 0.0746"/>
            <parent link="head_link"/>
            <child link="head_yaw_link"/>
            <axis xyz="0 0 1"/>
            <limit effort="60" lower="-1.5707963267948966" upper="1.5707963267948966" velocity="1.5"/>
            <dynamics damping="0.5" friction="0"/>
        </joint>

        <link name="head_pitch_link">
            <inertial>
                <origin xyz="0.046748 0.0077596 -0.033083"/>
                <mass value="0.56901"/>
                <inertia ixx="0.0032613" ixy="8.7738E-06" ixz="-2.3333E-06" iyy="0.0031112" iyz="1.3221E-06"
                         izz="0.0015503"/>
            </inertial>

            <visual>
                <geometry>
                    <mesh filename="file://$(find galbot_zero_description)/meshes/head/pitch.glb"/>
                </geometry>
            </visual>

            <collision>
                <origin xyz="0.046748 0.0077596 -0.033083"/>
                <geometry>
                    <box size=" 0.172  0.182 0.201"/>
                </geometry>
            </collision>
        </link>

        <joint name="head_joint2" type="revolute">
            <origin rpy="1.5708 -1.5708 0" xyz="0.074 -0.0345 0.0146"/>
            <parent link="head_yaw_link"/>
            <child link="head_pitch_link"/>
            <axis xyz="0 0 1"/>
            <limit effort="60" lower="-1.2217304763960306" upper="0.05235987755982988" velocity="1.5"/>
            <dynamics damping="0.5" friction="0"/>
        </joint>

        <link name="head_camera_normal_frame">
            <inertial>
                <origin xyz="-0.055827 0.032071 0.0047467"/>
                <mass value="0.30512"/>
                <inertia ixx="0.00025424" ixy="-1.1252E-06" ixz="2.9462E-05" iyy="0.00047177" iyz="9.9043E-08"
                         izz="0.00067985"/>
            </inertial>

            <visual>
                <geometry>
                    <mesh filename="file://$(find galbot_zero_description)/meshes/head/camera.glb"/>
                </geometry>
            </visual>

            <collision>
                <geometry>
                    <mesh filename="file://$(find galbot_zero_description)/meshes/head/camera.glb"/>
                </geometry>
            </collision>
        </link>

        <joint name="head_camera_normal_joint" type="fixed">
            <origin rpy="-1.5708 0 -1.5708" xyz="0.091 -0.0566 -0.0035"/>
            <parent link="head_pitch_link"/>
            <child link="head_camera_normal_frame"/>
            <axis/>
        </joint>

        <link name="head_camera_optical_frame"/>

        <joint name="head_camera_optical_joint" type="fixed">
            <origin rpy="1.5708 -1.5708 0" xyz="0.091 -0.0566 -0.0035"/>
            <parent link="head_pitch_link"/>
            <child link="head_camera_optical_frame"/>
            <axis/>
        </joint>
    </xacro:macro>
</robot>

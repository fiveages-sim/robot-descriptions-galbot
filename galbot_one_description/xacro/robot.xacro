<?xml version="1.0" ?>
<robot name="galbot_one" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="enable_wheel_joints" default="false"/>
  <xacro:arg name="arm_camera" default="d415"/>
  <xacro:arg name="collider" default="simple"/>
  <xacro:arg name="enable_suction_rotation" default="false"/>
  <xacro:arg name="eef_fixed_joints" default="false"/>
  <!-- type: hitbot | galbot_gripper | suction_cup | none -->
  <xacro:arg name="type" default="hitbot"/>
  <xacro:arg name="left_type" default=""/>
  <xacro:arg name="right_type" default=""/>

  <xacro:property name="PI" value="3.141592653589793"/>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <xacro:include filename="$(find galbot_one_description)/xacro/components/chassis.xacro"/>
  <xacro:include filename="$(find galbot_one_description)/xacro/components/body.xacro"/>
  <xacro:include filename="$(find galbot_one_description)/xacro/components/arm.xacro"/>
  <xacro:include filename="$(find galbot_foxtrot_description)/xacro/components/end_effector.xacro"/>
  <xacro:InitGalbotEeTypes type="$(arg type)" left_type_arg="$(arg left_type)"
                         right_type_arg="$(arg right_type)"/>

  <xacro:Arm name="left" direction="1" camera="$(arg arm_camera)"/>
  <xacro:Arm name="right" direction="-1" camera="$(arg arm_camera)"/>
  <xacro:GalbotOneChassis enable_wheel_joints="$(arg enable_wheel_joints)"/>

  <joint name="left_arm_mount_joint" type="fixed">
    <origin rpy="0 ${PI} 0" xyz="0 0 -0.13"/>
    <parent link="arm_base"/>
    <child link="left_base_link"/>
  </joint>

  <joint name="right_arm_mount_joint" type="fixed">
    <origin xyz="0 0 0.13"/>
    <parent link="arm_base"/>
    <child link="right_base_link"/>
  </joint>

  <xacro:GalbotArmEndEffector name="right" ee_type="${selected_right_ee_type}" variant="one"
                              collider="$(arg collider)"
                              enable_suction_rotation="$(arg enable_suction_rotation)"
                              eef_fixed_joints="$(arg eef_fixed_joints)"/>
  <xacro:GalbotArmEndEffector name="left" ee_type="${selected_left_ee_type}" variant="one"
                              collider="$(arg collider)"
                              enable_suction_rotation="$(arg enable_suction_rotation)"
                              eef_fixed_joints="$(arg eef_fixed_joints)"/>
</robot>

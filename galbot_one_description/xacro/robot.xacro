<?xml version="1.0" ?>
<robot name="galbot_one" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="enable_wheel_joints" default="false"/>
  <xacro:property name="PI" value="3.141592653589793"/>

  <!-- type options:
       - hitbot (default): show hitbot grippers
       - galbot_gripper: show galbot grippers
       - none: hide grippers (full-body visualization without end-effectors)
  -->
  <xacro:arg name="type" default="hitbot"/>
  <xacro:property name="type_arg" value="$(arg type)"/>
  <xacro:property name="selected_gripper_type" value="hitbot"/>
  <xacro:if value="${type_arg == 'hitbot'}">
    <xacro:property name="selected_gripper_type" value="hitbot"/>
  </xacro:if>
  <xacro:if value="${type_arg == 'galbot_gripper'}">
    <xacro:property name="selected_gripper_type" value="galbot_gripper"/>
  </xacro:if>
  <xacro:if value="${type_arg == 'none'}">
    <xacro:property name="selected_gripper_type" value="none"/>
  </xacro:if>
  <!-- Collision: simple (mesh collision) | convex_decomposition (decomposed meshes); arm/body/gripper (see components/*.xacro) -->
  <xacro:arg name="collider" default="simple"/>

  <!-- Robot Base Link -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <xacro:include filename="$(find galbot_one_description)/xacro/components/chassis.xacro"/>
  <xacro:include filename="$(find galbot_one_description)/xacro/components/body.xacro"/>
  <xacro:include filename="$(find galbot_one_description)/xacro/components/arm.xacro"/>
  <xacro:include filename="$(find galbot_one_description)/xacro/components/camera.xacro"/>

  <xacro:galbot_one_arm name="left" direction="1"/>
  <xacro:galbot_one_arm name="right" direction="-1"/>
  <xacro:GalbotOneArmCamera name="left" direction="1" parent="left_link7" collider_type="$(arg collider)"/>
  <xacro:GalbotOneArmCamera name="right" direction="-1" parent="right_link7" collider_type="$(arg collider)"/>
  <xacro:GalbotOneChassis enable_wheel_joints="$(arg enable_wheel_joints)"/>

  <joint name="left_arm_mount_joint" type="fixed">
    <origin rpy="0 ${PI} 0" xyz="0 0 -0.13"/>
    <parent link="arm_base"/>
    <child link="left_base_link"/>
  </joint>

  <joint name="right_arm_mount_joint" type="fixed">
    <origin xyz="0 0 0.13"/>
    <parent link="arm_base"/>
    <child link="right_base_link"/>
  </joint>

  <xacro:if value="${selected_gripper_type == 'hitbot'}">
    <xacro:include filename="$(find galbot_one_description)/xacro/components/galbot_hitbot_gripper.xacro"/>
    <xacro:hitbot_gripper name="right_gripper" parent="right_flange_mount_link">
      <origin xyz="0 0 0" rpy="0 -1.5708 0"/>
    </xacro:hitbot_gripper>
    <xacro:hitbot_gripper name="left_gripper" parent="left_flange_mount_link">
      <origin xyz="0 0 0" rpy="0 -1.5708 0"/>
    </xacro:hitbot_gripper>
  </xacro:if>

  <xacro:if value="${selected_gripper_type == 'galbot_gripper'}">
    <xacro:include filename="$(find galbot_foxtrot_description)/xacro/components/galbot_gripper.xacro"/>
    <xacro:Gripper name="right"/>
    <xacro:Gripper name="left"/>

    <joint name="left_gripper_mount_joint" type="fixed">
      <origin xyz="0 0 0.005" rpy="0 -1.5708 1.5708"/>
      <parent link="left_flange_mount_link"/>
      <child link="left_gripper_flange"/>
    </joint>

    <joint name="right_gripper_mount_joint" type="fixed">
      <origin xyz="0 0 0.005" rpy="0 -1.5708 1.5708"/>
      <parent link="right_flange_mount_link"/>
      <child link="right_gripper_flange"/>
    </joint>
  </xacro:if>

</robot>

<?xml version="1.0" ?>
<robot name="galbot_charlie_component" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="PI" value="3.141592653589793"/>
  <xacro:arg name="type" default="base"/>
  <xacro:arg name="enable_wheel_joints" default="true"/>
  <xacro:arg name="collider" default="simple"/>
  <xacro:arg name="enable_joint5" default="true"/>

  <xacro:if value="${'$(arg type)' == 'base'}">
    <xacro:include filename="$(find galbot_one_description)/xacro/components/chassis.xacro"/>
    <xacro:include filename="$(find galbot_one_description)/xacro/components/body.xacro"/>
    <xacro:GalbotOneChassis enable_wheel_joints="true"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'body'}">
    <link name="base_link"/>
    <joint name="base_joint" type="fixed">
      <parent link="base_link"/>
      <child link="omni_chassis_leg_mount_link"/>
    </joint>
    <link name="omni_chassis_leg_mount_link"/>
    <xacro:include filename="$(find galbot_one_description)/xacro/components/body.xacro"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'arm'}">
    <!-- Align arm-only structure with galbot_one component layout -->
    <link name="base_link"/>
    <joint name="arm_base_joint" type="fixed">
      <origin rpy="${PI/2} 0 0"/>
      <parent link="base_link"/>
      <child link="arm_base"/>
    </joint>
    <link name="arm_base"/>

    <joint name="left_arm_mount_joint" type="fixed">
      <origin rpy="0 ${PI} 0" xyz="0 0 -0.13"/>
      <parent link="arm_base"/>
      <child link="left_base_link"/>
    </joint>

    <joint name="right_arm_mount_joint" type="fixed">
      <origin xyz="0 0 0.13"/>
      <parent link="arm_base"/>
      <child link="right_base_link"/>
    </joint>

    <xacro:include filename="$(find galbot_charlie_description)/xacro/components/arm.xacro"/>
    <xacro:include filename="$(find galbot_one_description)/xacro/components/camera.xacro"/>
    <xacro:galbot_charlie_arm name="left" direction="1"/>
    <xacro:galbot_charlie_arm name="right" direction="-1"/>
    <link name="left_camera_mount_link"/>
    <joint name="left_camera_mount_joint" type="fixed">
      <origin xyz="0.03 0 0" rpy="0 -1.57 0"/>
      <parent link="left_link7"/>
      <child link="left_camera_mount_link"/>
    </joint>
    <link name="right_camera_mount_link"/>
    <joint name="right_camera_mount_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 -1.57 0"/>
      <parent link="right_link7"/>
      <child link="right_camera_mount_link"/>
    </joint>
    <xacro:GalbotOneArmCamera name="left" direction="1" parent="left_link7" flange_parent="left_camera_mount_link"/>
    <xacro:GalbotOneArmCamera name="right" direction="-1" parent="right_link7" flange_parent="right_camera_mount_link"/>
  </xacro:if>
</robot>

<?xml version="1.0" ?>
<robot name="galbot_charlie_ros2_control" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="type" default="hitbot"/>
  <xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
  <xacro:property name="type_arg" value="$(arg type)"/>
  <xacro:property name="selected_gripper_type" value="hitbot"/>
  <xacro:if value="${type_arg == 'hitbot'}">
    <xacro:property name="selected_gripper_type" value="hitbot"/>
  </xacro:if>
  <xacro:if value="${type_arg == 'galbot_gripper'}">
    <xacro:property name="selected_gripper_type" value="galbot_gripper"/>
  </xacro:if>
  <xacro:if value="${type_arg == 'none'}">
    <xacro:property name="selected_gripper_type" value="none"/>
  </xacro:if>
  <xacro:property name="ros2_control_config_basename" value="ros2_controllers.yaml"/>
  <xacro:if value="${selected_gripper_type == 'galbot_gripper'}">
    <xacro:property name="ros2_control_config_basename" value="galbot_gripper.yaml"/>
  </xacro:if>
  <xacro:property name="gripper_initial_value" value="1.57"/>
  <xacro:if value="${selected_gripper_type == 'hitbot'}">
    <xacro:property name="gripper_initial_value" value="0.75"/>
  </xacro:if>
  <xacro:arg name="gazebo" default="false"/>

  <xacro:include filename="$(find galbot_charlie_description)/xacro/robot.xacro"/>
  <xacro:include filename="$(find galbot_one_description)/xacro/ros2_control/galbot_one_base_interfaces.xacro"/>
  <xacro:include filename="$(find galbot_one_description)/xacro/ros2_control/galbot_one_arm_interfaces.xacro"/>

  <ros2_control name="galbot_charlie_unified_system" type="system">
    <hardware>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
        <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
        <param name="joint_commands_topic">/isaac/joint_command</param>
        <param name="joint_states_topic">/isaac/joint_states</param>
      </xacro:if>
    </hardware>

    <xacro:galbot_one_base_interfaces/>
    <xacro:galbot_one_arm_interfaces name="left" gripper_initial_value="${gripper_initial_value}"/>
    <xacro:galbot_one_arm_interfaces name="right" gripper_initial_value="${gripper_initial_value}"/>
  </ros2_control>

  <xacro:if value="$(arg gazebo)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find galbot_charlie_description)/config/ros2_control/${ros2_control_config_basename}</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
